{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Rotis Semi Sans|Rotis Sans Serif|Source Serif 4|Archivo Black))/i]",
        "message": "Font not provided by the design system. Available: Rotis Semi Sans, Rotis Sans Serif, Source Serif 4, Archivo Black."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--aberration-a",
      "--aberration-b",
      "--aberration-c",
      "--accent-1",
      "--accent-2",
      "--accent-3",
      "--canvas-margin",
      "--focus-black",
      "--focus-blue",
      "--focus-gray-100",
      "--focus-gray-300",
      "--focus-gray-500",
      "--focus-gray-700",
      "--focus-gray-900",
      "--focus-green",
      "--focus-ink",
      "--focus-ink-2",
      "--focus-magenta",
      "--focus-paper",
      "--focus-white",
      "--font-body",
      "--font-display",
      "--font-logo",
      "--logo-offset",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--surface-dark",
      "--surface-light",
      "--text-body-l",
      "--text-body-m",
      "--text-display-l",
      "--text-display-m",
      "--text-display-xl",
      "--text-eyebrow",
      "--text-on-dark",
      "--text-on-dark-muted",
      "--text-on-light",
      "--text-on-light-muted",
      "--tracking-eyebrow",
      "--tracking-wordmark"
    ],
    "tokenKinds": {
      "--focus-magenta": "color",
      "--focus-blue": "color",
      "--focus-green": "color",
      "--focus-black": "color",
      "--focus-white": "color",
      "--focus-ink": "color",
      "--focus-ink-2": "color",
      "--focus-paper": "color",
      "--focus-gray-100": "color",
      "--focus-gray-300": "color",
      "--focus-gray-500": "color",
      "--focus-gray-700": "color",
      "--focus-gray-900": "color",
      "--surface-dark": "color",
      "--surface-light": "color",
      "--text-on-dark": "font",
      "--text-on-dark-muted": "font",
      "--text-on-light": "font",
      "--text-on-light-muted": "font",
      "--accent-1": "color",
      "--accent-2": "color",
      "--accent-3": "color",
      "--aberration-a": "color",
      "--aberration-b": "color",
      "--aberration-c": "color",
      "--font-display": "font",
      "--font-body": "font",
      "--font-logo": "font",
      "--text-display-xl": "font",
      "--text-display-l": "font",
      "--text-display-m": "font",
      "--text-body-l": "font",
      "--text-body-m": "font",
      "--text-eyebrow": "font",
      "--tracking-wordmark": "font",
      "--tracking-eyebrow": "font",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
      "--space-7": "spacing",
      "--canvas-margin": "spacing",
      "--logo-offset": "spacing"
    },
    "fontFamilies": [
      "Archivo Black",
      "Rotis Sans Serif",
      "Rotis Semi Sans",
      "Source Serif 4"
    ]
  }
}