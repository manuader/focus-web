{
  "$schema": "tokens FOCUS creatives · fuente: focus-web/src/app/globals.css (port 1:1 del Design System de Claude Design) y estilos de texto del sitio",
  "color": {
    "magenta": "#FF00FF", "blue": "#0033FF", "blue-text": "#5B8CFF", "green": "#00FF33",
    "black": "#000000", "white": "#FFFFFF",
    "ink": "#0A0A0B", "ink-2": "#17181B", "paper": "#F6F6F4",
    "gray-100": "#E7E9EC", "gray-300": "#A7ACB4", "gray-400": "#7C818A", "gray-500": "#6B7078", "gray-700": "#3A3D42", "gray-900": "#17181B",
    "spectrum": ["#FF00FF", "#C010FF", "#8020FF", "#0033FF", "#0080DD", "#00C088", "#00FF33"],
    "_notas": {
      "blue-text": "#0033FF da 2,47:1 sobre ink; en texto chico se usa #5B8CFF (6,2:1)",
      "gray-400": "el gris más oscuro que pasa AA en texto chico sobre ink (5,0:1)",
      "spectrum": "solo para el haz de siete bandas, una por servicio"
    }
  },
  "semantic": {
    "surface-dark": "ink", "surface-light": "paper",
    "text-on-dark": "white", "text-on-dark-muted": "gray-300",
    "text-on-light": "ink", "text-on-light-muted": "gray-500",
    "accent-1": "magenta", "accent-2": "blue", "accent-3": "green"
  },
  "font": {
    "body": "Rotis Semi Sans (fonts/RotisSemiSansStd-*.otf) · Light 300 · Light Italic · Italic 400 · Bold 700 · ExtraBold 800",
    "display": "Source Serif 4 Italic (fonts/SourceSerif4-Italic-latin.woff2) · reemplaza a Rotis Semi Serif, que nunca se entregó",
    "logo": "Archivo Black (solo el wordmark animado y la palabra REFRACCIÓN del sitio)"
  },
  "type": {
    "titular": { "family": "body", "weight": 800, "case": "upper", "tracking": "-0.035em", "leading": 0.95, "ejemplos": ["QUÉ HACEMOS", "CASOS", "MIRAR"] },
    "bajada-serif": { "family": "display", "style": "italic", "weight": 400, "case": "as-is", "color": "gray-300", "ejemplos": ["lo que ya es tuyo", "un solo criterio"] },
    "enunciado": { "family": "body", "weight": 300, "case": "sentence", "tracking": "-0.025em", "leading": 1.02, "enfasis": "una palabra en 800", "ejemplos": ["Una marca no se inventa. Se **enfoca**."] },
    "eyebrow-seccion": { "family": "display", "style": "italic", "weight": 400, "color": "gray-300", "filete": "54 px a la izquierda", "ejemplos": ["Servicios", "Trabajo seleccionado"] },
    "micro-rotulo": { "family": "body", "weight": 700, "case": "upper", "tracking": "0.26em", "color": "gray-300", "ejemplos": ["TU DEDO ES LA LENTE · ENFOCÁ LO QUE IMPORTA"] },
    "cuerpo": { "family": "body", "weight": 300, "leading": 1.32 },
    "escala-reel-1080x1920": { "titular": "96–150 px", "enunciado": "84–132 px", "cuerpo": "44–56 px", "eyebrow": "38–42 px", "micro-rotulo": "24–30 px", "minimo-legible": "40 px" },
    "escala-carrusel-1080x1350": { "titular": "96–136 px", "enunciado": "80–100 px", "cuerpo": "40–48 px", "eyebrow": "38 px" }
  },
  "space": { "base": 8, "scale": [8, 16, 24, 40, 64, 96, 140], "edge-web": "40 px (20 px en teléfono)", "edge-redes": "80 px sobre 1080" },
  "motion": {
    "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)", "ease-in-expo": "cubic-bezier(0.7, 0, 0.84, 0)",
    "rack-focus": "blur 16→0 px · 0,8–1,2 s", "refraccion": "3 capas screen ±8–40 px → blanco · 0,6–1 s",
    "anillos": "40–60 s por vuelta", "lectura": "0,3 s por palabra + 0,5 s"
  },
  "formatos": {
    "reel": { "size": [1080, 1920], "fps": 30, "safe": { "x": [80, 1000], "y": [250, 1500] }, "loudness": "-14 LUFS" },
    "carrusel": { "size": [1080, 1350], "safe": { "x": [80, 1000], "y": [80, 1270] }, "grilla-3x4": "titular de portada en x 34–1046" },
    "historia": { "size": [1080, 1920], "safe": { "y": [220, 1580] } }
  }
}
